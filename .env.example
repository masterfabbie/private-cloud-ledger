# Copy to .env and adjust.

# The first admin is created from these on the very first start (when no users exist).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Set to true when the app is served over HTTPS (behind a reverse proxy).
COOKIE_SECURE=false

# Allow people to create their own account on the login page.
ALLOW_REGISTRATION=false

# Session lifetime in days and maximum CSV upload size.
SESSION_DAYS=14
MAX_UPLOAD_MB=10

# Signs the short-lived cookie used during single sign-on. Optional; a random key is used
# when empty (a login that is in progress fails after a restart, nothing else).
SECRET_KEY=

# Public address of the app, used to build the SSO redirect URI. Set it when running
# behind a reverse proxy, e.g. https://ledger.example.com
PUBLIC_URL=

# Set to false to allow only single sign-on (hides the username/password form).
PASSWORD_LOGIN=true

# ---- Single sign-on via OpenID Connect (authentik, Keycloak, Zitadel, Authelia, ...)
# Leave OIDC_ISSUER_URL empty to disable. Redirect URI to register at the provider:
#   <PUBLIC_URL>/api/auth/oidc/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button text on the login page: "Log in with <name>"
OIDC_DISPLAY_NAME=SSO
OIDC_SCOPES=openid email profile
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
# Members of this group become admins (synced on every login). Empty = manage admins in the app.
OIDC_ADMIN_GROUP=
# Attach SSO logins to existing local users with the same username (only if you trust the
# provider's usernames). Otherwise a new user is created, e.g. "admin-2".
OIDC_LINK_EXISTING_USERS=false

# ---- Bank sync via FinTS/HBCI (Sparkassen, Volksbanken, DKB, ING, ...)
# FinTS product registration number from the Deutsche Kreditwirtschaft (free).
# Bank sync stays disabled until this is set.
FINTS_PRODUCT_ID=
# Automatic sync interval for connections with a stored PIN and "sync automatically" on; 0 = off.
# Storing PINs requires SECRET_KEY above.
BANK_SYNC_INTERVAL_HOURS=6
